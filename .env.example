# Supabase project URL and API keys (Project Settings > API / API Keys).
# Server-only values. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# The confirmed Supabase Auth user's email allowed to edit the archive.
OWNER_EMAIL=you@example.com

# Must match the private bucket created by the SQL migration.
SUPABASE_STORAGE_BUCKET=archive-images
